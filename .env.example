# Application
APP_ENV=development
LOG_LEVEL=INFO
PORT=8000

# PostgreSQL development container
# These values are for local development only. Change POSTGRES_PASSWORD in your local .env file.
POSTGRES_DB=airaware
POSTGRES_USER=airaware
POSTGRES_PASSWORD=airaware_dev_password

# Used when running the backend directly from this repository.
DATABASE_URL=postgresql+psycopg://airaware:airaware_dev_password@localhost:5432/airaware

# Live data providers
OPENAQ_API_KEY=
OPENAQ_LOCATION_ID=6145551
OPENAQ_SENSOR_ID=14745878
STATION_NAME=Anand Lok, New Delhi
STATION_LATITUDE=28.5587
STATION_LONGITUDE=77.21886

# OPENAQ_LOCATION_ID=8118
# OPENAQ_SENSOR_ID=23534
# STATION_NAME=New Delhi
# STATION_LATITUDE=28.63576
# STATION_LONGITUDE=77.22445


STATION_TIMEZONE=Asia/Kolkata
PROVIDER_TIMEOUT_SECONDS=20
MAXIMUM_OBSERVATION_AGE_MINUTES=180
# Required PM2.5 history for the existing operational forecast models (7 days).
PM25_HISTORY_HOURS=168

# Directory containing local trained model files. It is ignored by Git.
MODEL_ARTIFACT_DIRECTORY=backend/model_artifacts

# The Docker worker runs one ingestion and forecast cycle at this interval.
WORKER_INTERVAL_SECONDS=3600
